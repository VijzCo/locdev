rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Site content: anyone may read it — it IS the public website.
    // Only a signed-in admin may change it.
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Enquiries: anyone may submit one, nobody may read them back except an
    // admin. This is the rule that keeps buyer contact details private.
    match /enquiries/{id} {
      allow create: if request.auth == null || request.auth != null;
      allow read, update, delete: if request.auth != null;
    }

    // Images stored as documents, because Storage requires the Blaze plan.
    // Public read — they appear on the website. Admin-only write.
    match /images/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
