rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PUBLIC READ — anyone can read these collections (for public website)
    match /company/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /leadership/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /factories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /services/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
