# =========================================================================
# Firebase Web SDK config (client-side, safe to expose — protected by rules)
# Get these from: Firebase Console -> Project Settings -> Your apps -> Web
# =========================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =========================================================================
# Firebase Admin SDK (server-side only — NEVER expose to client)
# Generate from: Firebase Console -> Project Settings -> Service Accounts
# Paste the entire JSON as a single line, or use the individual fields.
# =========================================================================
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# =========================================================================
# Stripe — subscription billing
# =========================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe price IDs for each plan
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=

# =========================================================================
# App config
# =========================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SMV Platform

# Emulator toggle for local Firebase development
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
