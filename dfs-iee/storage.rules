rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function tenantOfUser() {
      // The tenantId is set as a custom claim by Cloud Functions
      return request.auth.token.tenantId;
    }

    // Tenant-scoped uploads: /tenants/{tenantId}/...
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if isSignedIn() && tenantOfUser() == tenantId;
      allow write: if isSignedIn()
        && tenantOfUser() == tenantId
        && request.resource.size < 10 * 1024 * 1024  // 10 MB cap per file
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('application/pdf') ||
          request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*') ||
          request.resource.contentType.matches('text/.*')
        );
    }

    // User avatars
    match /users/{userId}/avatar/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
