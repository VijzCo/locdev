# Firebase — Increment 2. Copy to .env.local and fill from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vendor access is granted by a vendorAdmins/{your-uid} document created in
# the Firestore console. Nothing to configure here.
